<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    parallel="classes" thread-count="4" / maxPoolSize=2: restored on the new
    laptop (16GB RAM, minikube sized at 4 CPU / 6GB). The earlier PC-2 machine
    only had ~5.85GB total RAM with minikube capped at ~3GB, and two
    concurrent headless Chrome instances starved the renderer process there
    ("SessionNotCreatedException: unable to connect to renderer") — see git
    history for the parallel="none" fallback that was needed on that machine.
    Not a concern on this hardware; the pod's resource limits (2 CPU / 4Gi,
    see k8s/test-job.yaml) leave headroom for 2 concurrent Chrome drivers.
-->
<suite name="Regression Test Suite" parallel="classes" thread-count="4" verbose="2">
    <parameter name="configClass" value="com.leaftaps.config.data.LeafTapConfiguration"/>
    <parameter name="environment" value="qa"/>
    <parameter name="browser"      value="chrome"/>
    <parameter name="maxPoolSize"  value="2"/>
	<parameter name="headless" value="true"/>
    <test name="Full Regression">
        <classes>
            <class name="com.leaftaps.testcases.TC001_Verify"/>
            <class name="com.leaftaps.testcases.TC001_VerifyLogin"/>
            <class name="com.leaftaps.testcases.TC002_VerifyLogout"/>
            <class name="com.leaftaps.testcases.TC003_CreateLead"/>
            <class name="com.leaftaps.testcases.TC004_EditLead"/>
            <class name="com.leaftaps.testcases.TC005_DeleteLead"/>
            <class name="com.leaftaps.testcases.TC006_DuplicateLead"/>
        </classes>
    </test>
</suite>
