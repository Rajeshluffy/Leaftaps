<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    thread-count="2" matches maxPoolSize="2" deliberately: with thread-count=4
    and only 2 pooled Chrome drivers, 4 threads competed for 2 drivers and the
    2 that lost timed out after 30s with "Borrow timeout — CHROME pool
    exhausted (max=2)". Raising the pod's CPU limit (see k8s/test-job.yaml,
    now 3) fixed the earlier CPU-starvation crashes, but thread-count must
    never exceed maxPoolSize or excess threads will always stall waiting on a
    driver. Bump both together if you want more real parallelism later.
-->
<suite name="Regression Test Suite" parallel="classes" thread-count="2" verbose="2">
    <parameter name="configClass" value="com.leaftaps.config.data.LeafTapConfiguration"/>
    <parameter name="environment" value="qa"/>
    <parameter name="browser"      value="chrome"/>
    <parameter name="maxPoolSize"  value="2"/>
	<parameter name="headless" value="true"/>
    <test name="Full Regression">
        <classes>
            <class name="com.leaftaps.testcases.TC001_Verify"/>
            <class name="com.leaftaps.testcases.TC001_VerifyLogin"/>
            <class name="com.leaftaps.testcases.TC002_VerifyLogout"/>
            <class name="com.leaftaps.testcases.TC003_CreateLead"/>
            <class name="com.leaftaps.testcases.TC004_EditLead"/>
            <class name="com.leaftaps.testcases.TC005_DeleteLead"/>
            <class name="com.leaftaps.testcases.TC006_DuplicateLead"/>
        </classes>
    </test>
</suite>
