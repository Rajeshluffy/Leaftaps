<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    parallel="methods", not "classes": with only 2 threads and 7 unevenly-sized
    classes (some ~1-5s, TC003_CreateLead/TC004_EditLead 10-40s+), "classes"
    scheduling handed one thread a single long class and nothing else while the
    other thread churned through 3 classes back to back — one Chrome instance
    sat idle for most of the run (confirmed in CI logs: Thread-1 ran only
    TC004_EditLead, Thread-2 ran 3 classes sequentially). TestNG's "classes"
    mode queues whole classes with no duration awareness; "methods" queues
    individual @Test methods instead, so any thread that frees up immediately
    grabs the next available method — self-balancing regardless of class count
    or duration skew, with zero manual XML maintenance as the suite grows.
    thread-count must still match maxPoolSize (both 2) — see prior history for
    why a mismatch causes CHROME pool exhaustion.
-->
<suite name="Regression Test Suite" parallel="methods" thread-count="2" verbose="2">
    <parameter name="configClass" value="com.leaftaps.config.data.LeafTapConfiguration"/>
    <parameter name="environment" value="qa"/>
    <parameter name="browser"      value="chrome"/>
    <parameter name="maxPoolSize"  value="2"/>
	<parameter name="headless" value="true"/>
    <test name="Full Regression">
        <classes>
            <class name="com.leaftaps.testcases.TC001_Verify"/>
            <class name="com.leaftaps.testcases.TC001_VerifyLogin"/>
            <class name="com.leaftaps.testcases.TC002_VerifyLogout"/>
            <class name="com.leaftaps.testcases.TC003_CreateLead"/>
            <class name="com.leaftaps.testcases.TC004_EditLead"/>
            <class name="com.leaftaps.testcases.TC005_DeleteLead"/>
            <class name="com.leaftaps.testcases.TC006_DuplicateLead"/>
        </classes>
    </test>
</suite>
