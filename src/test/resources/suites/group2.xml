<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Parallel split of regression.xml — Group 2 of 2 (Delete/Duplicate/data-driven
    login verify). Runs as its own Kubernetes Job alongside group1.xml so the
    full regression suite completes in roughly half the wall-clock time.
-->
<suite name="Regression Group 2" parallel="classes" thread-count="4" verbose="2">
    <parameter name="configClass" value="com.leaftaps.config.data.LeafTapConfiguration"/>
    <parameter name="environment" value="qa"/>
    <parameter name="browser"      value="chrome"/>
    <parameter name="maxPoolSize"  value="2"/>
    <parameter name="headless" value="true"/>
    <test name="Regression Group 2">
        <classes>
            <class name="com.leaftaps.testcases.TC005_DeleteLead"/>
            <class name="com.leaftaps.testcases.TC006_DuplicateLead"/>
            <class name="com.leaftaps.testcases.TC001_Verify"/>
        </classes>
    </test>
</suite>
